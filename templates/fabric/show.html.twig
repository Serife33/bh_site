{% extends 'base.html.twig' %}

{% block title %}{{ fabric.name }}{% endblock %}

{% block body %}
    <h1>{{ fabric }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Type de tissu</th>
                <td>{{ fabric.name }}</td>
            </tr>
            <tr>
                <th>Référence</th>
                <td>{{ fabric.reference ?: '—' }}</td>
            </tr>
            <tr>
                <th>Fournisseur</th>
                <td>{{ fabric.supplier ?: '—' }}</td>
            </tr>
        </tbody>
    </table>

    
    
    <h2>Nuancier</h2>

    {% if fabric.fabricColors is empty %}
        <p class="empty">Aucune couleur enregistrée pour ce tissu.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr>
                    <th>Ordre</th>
                    <th>Nom de la couleur</th>
                    <th>Couleur</th>
                    <th>Macro</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for fc in fabric.fabricColors %}
                <tr>
                    <td>{{ fc.position }}</td>
                    <td>{{ fc.name }}</td>
                    <td><span class="swatch" style="--swatch-color: {{ fc.hex }}"></span></td>
                    <td>
                        {% if fc.image %}
                            <img class="macro-thumb" src="{{ vich_uploader_asset(fc, 'imageFile') | imagine_filter('vignette') }}" alt="">
                        {% else %}
                            <span class="empty">pas de photo</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_fabric_color_edit', {'id': fc.id}) }}">Modifier</a>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <a class="btn" href="{{ path('app_fabric_color_new') }}">+ Ajouter une couleur</a>

    <a href="{{ path('app_fabric_index') }}">Retour à la liste</a>

    <a href="{{ path('app_fabric_edit', {'id': fabric.id}) }}">Modifier</a>

    {{ include('fabric/_delete_form.html.twig') }}
{% endblock %}
