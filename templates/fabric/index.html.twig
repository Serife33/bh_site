{% extends 'base.html.twig' %}

{% block title %}Tissus{% endblock %}

{% block body %}
    <h1>Tissus</h1>

    <a class="btn" href="{{ path('app_fabric_new') }}">+ Nouveau tissu</a>

    <table class="table">
        <thead>
            <tr>
                <th>Tissu</th>
                <th>Référence</th>
                <th>Fournisseur</th>
                <th>Couleurs</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for fabric in fabrics %}
            <tr>
                <td>{{ fabric.name }}</td>
                <td>{{ fabric.reference ?: '—' }}</td>
                <td>{{ fabric.supplier ?: '—' }}</td>
                <td>{{ fabric.fabricColors|length }}</td>
                <td>
                    <a href="{{ path('app_fabric_show', {'id': fabric.id}) }}">Voir</a>
                    <a href="{{ path('app_fabric_edit', {'id': fabric.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun tissu enregistré.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
