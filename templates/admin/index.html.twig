{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <h1>Tableau de bord</h1>
    <p>Bienvenue dans l'administration de Brillance Home.</p>

    <div class="dash-grid">
        <a class="dash-card" href="{{ path('app_product_index') }}">
            <span class="dash-card-title">Produits</span>
            <span class="dash-card-desc">Catalogue, prix, photos, mise en avant</span>
        </a>
        <a class="dash-card" href="{{ path('app_category_index') }}">
            <span class="dash-card-title">Catégories</span>
            <span class="dash-card-desc">Les grands univers (Canapés, Literie…)</span>
        </a>
        <a class="dash-card" href="{{ path('app_sub_category_index') }}">
            <span class="dash-card-title">Sous-catégories</span>
            <span class="dash-card-desc">Étiquettes de filtre (3 places, d'angle…)</span>
        </a>
        <a class="dash-card" href="{{ path('app_fabric_index') }}">
            <span class="dash-card-title">Tissus</span>
            <span class="dash-card-desc">Les matières proposées</span>
        </a>
        <a class="dash-card" href="{{ path('app_color_index') }}">
            <span class="dash-card-title">Couleurs</span>
            <span class="dash-card-desc">Les coloris proposés</span>
        </a>
        <a class="dash-card" href="{{ path('app_family_index') }}">
            <span class="dash-card-title">Familles</span>
            <span class="dash-card-desc">Regrouper les variantes d'un même modèle</span>
        </a>
    </div>
{% endblock %}