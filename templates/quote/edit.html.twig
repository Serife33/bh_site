{% extends 'base.html.twig' %}

{# Création et modification d'un devis : le même écran (docs/UX-DEVIS.md). Cinq sections dans l'ordre de la conversation
   avec le client, le récapitulatif à droite. Rien n'apparaît ni ne disparaît : un champ inutile est grisé, une phrase dit
   pourquoi (assets/devis.js). #}
{% form_theme form 'quote/_form_theme.html.twig' %}
{% import 'quote/_article.html.twig' as articles %}
{% import 'document/macros.html.twig' as doc %}
{% set titre = quote.number ? 'Devis ' ~ quote.number : 'Nouveau devis' %}

{% block title %}{{ titre }}{% endblock %}

{% block body %}
    <a class="retour" href="{{ path('app_quote_index') }}">← Retour à la liste des devis</a>
    <div class="tete">
        <h1>{{ titre }}</h1>
        <span class="pastille st-{{ quote.status.value }}">{{ quote.status.label }}</span>
        <p class="aide">
            {{- quote.number ? 'Créé le ' ~ quote.createdAt|date_longue ~ ' par ' ~ quote.seller.email ~ '.' : 'Le numéro sera attribué au premier enregistrement.' -}}
        </p>
    </div>

    {# Les taux du calcul en direct : ceux enregistrés sur le devis, jamais recopiés à la main #}
    {{ form_start(form, {attr: {id: 'form-devis', class: 'grille', 'data-tva': quote.vatRate, 'data-acompte': quote.depositRate}}) }}
        <div>
            {{ form_errors(form) }}

            {# Le client se cherche comme un produit ; sa fiche se crée ou se modifie dans un nouvel onglet : le devis reste ouvert #}
            {% set client_id = form.customer.vars.id ~ '_recherche' %}
            <section class="bloc" aria-labelledby="section-client" data-client="{{ client ? client|json_encode }}">
                <h2 id="section-client"><span class="etape" aria-hidden="true">1</span>Client</h2>
                <div class="champ">
                    <label for="{{ client_id }}">Client <span class="obl">(obligatoire)</span></label>
                    <div class="recherche">
                        <input type="text" id="{{ client_id }}" value="{{ client.name ?? '' }}" autocomplete="off"
                               role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="{{ client_id }}_resultats"
                               aria-describedby="{{ ([client_id ~ '_aide']|merge(form.customer.vars.errors|map((_, i) => form.customer.vars.id ~ '_error' ~ (i + 1))))|join(' ') }}"
                               {{- form.customer.vars.valid ? '' : ' aria-invalid="true"' }} data-source="client" data-url="{{ path('app_quote_customers') }}">
                        <ul id="{{ client_id }}_resultats" class="resultats" role="listbox" aria-label="Clients trouvés" hidden></ul>
                    </div>
                    {{ form_widget(form.customer) }}
                    {{ form_errors(form.customer) }}
                    <p class="aide" id="{{ client_id }}_aide">Tapez 2 lettres du nom, ou le début du téléphone.</p>
                </div>
                <div class="fiche-client" data-fiche-client></div>
                <p class="lien-ajout"><a href="{{ path('app_customer_new') }}" target="_blank">+ Nouveau client (nouvel onglet)</a></p>
            </section>

            <section class="bloc" aria-labelledby="section-articles">
                <h2 id="section-articles"><span class="etape" aria-hidden="true">2</span>Articles</h2>
                <p class="aide">Prix TTC, comme sur le site. Une remise d'article porte sur le total de l'article (prix × quantité).</p>
                {{ form_errors(form.lines) }}
                {# Le prochain numéro de ligne suit le dernier, pas le nombre de lignes : après un retrait, ils diffèrent #}
                <div id="articles"
                     data-prototype="{{ articles.article(form.lines.vars.prototype, '__numero__', catalogue)|e('html_attr') }}"
                     data-index="{{ form.lines|length ? form.lines|last.vars.name + 1 : 0 }}">
                    {% for ligne in form.lines %}{{ articles.article(ligne, loop.index, catalogue) }}{% endfor %}
                </div>
                {% do form.lines.setRendered %}
                <button type="button" class="btn-secondaire btn-ajout" id="ajouter-article" data-action="ajouter">+ Ajouter un article</button>
                <div class="remise-globale">{{ form_row(form.discountType) }}</div>
            </section>

            <section class="bloc" aria-labelledby="section-livraison">
                <h2 id="section-livraison"><span class="etape" aria-hidden="true">3</span>Livraison, montage et délai</h2>
                {# Un prix enregistré à 0 s'affiche vide : son résultat dit « offerte », pas un « 0,00 » qui ressemble à un oubli #}
                <div class="g-options">
                    <fieldset>
                        <legend>{{ form.delivery.vars.label }}</legend>
                        {{ form_widget(form.delivery, {attr: {class: 'segments large'}}) }}
                        {{ form_errors(form.delivery) }}
                        {{ form_row(form.deliveryFee, {value: form.deliveryFee.vars.value == 0 ? '' : form.deliveryFee.vars.value}) }}
                        <div class="champ">
                            <p class="libelle">Adresse de livraison</p>
                            <p class="valeur" data-adresse-livraison></p>
                        </div>
                    </fieldset>
                    <fieldset>
                        <legend>Montage</legend>
                        {{ form_row(form.assembly) }}
                        {{ form_row(form.assemblyFee, {value: form.assemblyFee.vars.value == 0 ? '' : form.assemblyFee.vars.value}) }}
                    </fieldset>
                </div>
                {# Les délais des articles du catalogue, et des raccourcis qui ne remplissent rien sans clic #}
                <div class="c-delai">
                    {{ form_row(form.leadTime) }}
                    <p class="aide deux" data-delais-catalogue></p>
                    <div class="raccourcis">
                        <button type="button" class="btn-secondaire" data-action="delai" data-delai-catalogue>Utiliser le délai du catalogue</button>
                        <button type="button" class="btn-secondaire" data-action="delai" data-delai="Disponible immédiatement">Disponible immédiatement</button>
                    </div>
                </div>
            </section>

            <section class="bloc" aria-labelledby="section-acompte">
                <h2 id="section-acompte"><span class="etape" aria-hidden="true">4</span>Acompte</h2>
                <fieldset>
                    <legend>Acompte à la commande</legend>
                    {% for choix in form.depositMode %}
                        <label class="case" for="{{ choix.vars.id }}">
                            {{- form_widget(choix) -}}
                            {%- if choix.vars.value == 'taux' -%}
                                <span>{{ doc.taux(quote.depositRate) }} du total TTC : <strong data-acompte-calcule></strong></span>
                            {%- else -%}
                                Un autre montant
                            {%- endif -%}
                        </label>
                    {% endfor %}
                    {{ form_row(form.depositAmount, {row_attr: {class: 'c-acompte'}}) }}
                </fieldset>
            </section>

            <section class="bloc" aria-labelledby="section-suivi">
                <h2 id="section-suivi"><span class="etape" aria-hidden="true">5</span>Suivi du devis</h2>
                <div class="g-suivi">
                    {{ form_row(form.status) }}
                    {{ form_row(form.validUntil) }}
                    {{ form_row(form.seller) }}
                </div>
                {{ form_row(form.notes) }}
            </section>
        </div>

        <aside class="recap" id="recapitulatif" aria-labelledby="titre-recap">
            <section class="bloc">
                <h2 id="titre-recap">Récapitulatif</h2>
                {{ include('quote/_totals.html.twig', {saisie: true}) }}
                <p class="aide">HT = TTC ÷ 1,2. Recalculé à l'enregistrement.</p>
            </section>
            <section class="bloc actions" aria-label="Enregistrement">
                <button type="submit">Enregistrer</button>
                {% if quote.id %}
                    <a href="{{ path('app_quote_print', {id: quote.id}) }}" data-turbo="false">Devis imprimable (imprimer, supprimer)</a>
                {% endif %}
            </section>
        </aside>
    {{ form_end(form) }}
{% endblock %}
