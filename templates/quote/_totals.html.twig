{# Les montants du devis, au même format sur l'écran de saisie et sur le devis imprimé.
   data-total : la case que assets/devis.js remet à jour pendant la saisie. #}
{% import 'document/macros.html.twig' as doc %}
<table class="totaux">
    <tr><th>Total des articles</th><td data-total="items">{{ totaux.items|prix(2) }}</td></tr>
    {% if totaux.discount > 0 or saisie|default(false) %}
        <tr><th>Remise globale</th><td data-total="discount">{{ totaux.discount > 0 ? '-' }}{{ totaux.discount|prix(2) }}</td></tr>
    {% endif %}
    {# Livraison et montage : sur le document, une ligne seulement s'ils sont cochés ; à l'écran de saisie (saisie),
       toujours leurs deux lignes, mises à jour par assets/devis.js #}
    {% if quote.delivery or saisie|default(false) %}
        <tr><th>Livraison</th><td data-total="delivery">{{ not quote.delivery ? 'retrait au showroom' : (totaux.delivery > 0 ? totaux.delivery|prix(2) : 'offerte') }}</td></tr>
    {% endif %}
    {% if quote.assembly or saisie|default(false) %}
        <tr><th>Montage</th><td data-total="assembly">{{ not quote.assembly ? 'sans montage' : (totaux.assembly > 0 ? totaux.assembly|prix(2) : 'offert') }}</td></tr>
    {% endif %}
    <tr><th>Total HT</th><td data-total="ht">{{ totaux.ht|prix(2) }}</td></tr>
    <tr><th>TVA {{ doc.taux(quote.vatRate) }}</th><td data-total="tva">{{ totaux.tva|prix(2) }}</td></tr>
    <tr class="ttc"><th>Total TTC</th><td data-total="ttc">{{ totaux.ttc|prix(2) }}</td></tr>
    {# La part du total : le taux du devis, ou celle de l'acompte saisi #}
    <tr class="acompte"><th>Acompte <span data-part-acompte>{{ doc.taux(totaux.depositShare) }}</span> à la commande</th><td data-total="deposit">{{ totaux.deposit|prix(2) }}</td></tr>
    <tr class="solde"><th>Reste à payer <span data-moment-solde>{{ quote.delivery ? 'à la livraison' : 'au retrait' }}</span></th><td data-total="balance">{{ totaux.balance|prix(2) }}</td></tr>
</table>
