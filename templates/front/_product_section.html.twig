
{# Section produits réutilisable. Reçoit : titre, sous_titre (facultatif), products, en_avant (facultatif : la grande bande noire).
   Ne s'affiche PAS si la liste est vide. #}
{% set en_avant = en_avant|default(false) %}
{% if products|length > 0 %}
<section class="section{{ en_avant ? ' dark avant' }}">
    <div class="wrap">
        <div class="section-head">
            <h2>{{ titre }}</h2>
            {% if sous_titre %}<p>{{ sous_titre }}</p>{% endif %}
        </div>
        <div class="grid-produits">
            {% for product in products %}
                {{ include('front/_product_card.html.twig', { product: product, en_avant: en_avant }) }}
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}