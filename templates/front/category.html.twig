{% extends 'front/base.html.twig' %}

{% block title %}{{ category.metaTitle ?? (category.name ~ ' — Brillance Home') }}{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap">

        {# --- Fil d'Ariane --- #}
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <a href="{{ path('front_home') }}">Accueil</a>
            <span aria-hidden="true">›</span>
            <span>{{ category.name }}</span>
        </nav>

        {# --- Titre + texte SEO de la catégorie --- #}
        <div class="section-head">
            <h1>{{ category.name }}</h1>
            {% if category.seoText %}
                <p>{{ category.seoText }}</p>
            {% endif %}
        </div>

        {# --- Filtres sous-catégorie --- #}
        {% if subCategories %}
            <nav class="subcats" aria-label="Filtrer par type">
                <a href="{{ path('front_category', { slug: category.slug }) }}"
                   class="chip {{ currentSubCategory is null ? 'is-active' }}">Tous</a>
                {% for sc in subCategories %}
                    <a href="{{ path('front_category', { slug: category.slug, 'sous-categorie': sc.slug }) }}"
                       class="chip {{ currentSubCategory and currentSubCategory.id == sc.id ? 'is-active' }}">{{ sc.name }}</a>
                {% endfor %}
            </nav>
        {% endif %}

        {# --- Grille produits (pagination = SEULEMENT les 12 de la page) --- #}
        <div class="grid-produits">
            {% for product in pagination %}
                {{ include('front/_product_card.html.twig', { product: product }) }}
            {% else %}
                <p class="empty">Aucun produit dans cette catégorie pour le moment.</p>
            {% endfor %}
        </div>

        {# --- Liens « ‹ 1 2 3 › » générés par KnpPaginator --- #}
        <div class="pagination">
            {{ knp_pagination_render(pagination) }}
        </div>

    </div>
</section>
{% endblock %}