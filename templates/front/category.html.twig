{% extends 'front/base.html.twig' %}

{% block canonical %}{{ url('front_category', { slug: category.slug }) }}{% if app.request.query.getInt('page', 1) > 1 %}?page={{ app.request.query.getInt('page') }}{% endif %}{% endblock %}

{% block title %}{{ category.metaTitle ?? (category.name ~ ' — Brillance Home') }}{% endblock %}
{% block meta_description %}{{ category.metaDescription ?: (category.name ~ ' — Brillance Home, ameublement d\'intérieur à Bordeaux.') }}{% endblock %}


{% block json_ld %}
    {% set breadcrumb = {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Accueil', 'item': url('front_home') },
            { '@type': 'ListItem', 'position': 2, 'name': category.name, 'item': url('front_category', { slug: category.slug }) }
        ]
    } %}
    <script type="application/ld+json">{{ breadcrumb|json_encode|raw }}</script>
{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap">

        {# --- Fil d'Ariane --- #}
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <a href="{{ path('front_home') }}">Accueil</a>
            <span aria-hidden="true">›</span>
            <span>{{ category.name }}</span>
        </nav>

        {# --- Titre + intro de la catégorie --- #}
        {% set paragraphes = (category.seoText ?? '')|replace({"\r\n": "\n"})|split("\n\n")|filter(p => p|trim) %}
        <div class="section-head">
            <h1>{{ category.name }}</h1>
            {% if paragraphes|length %}
                <p>{{ paragraphes|first|trim|nl2br }}</p>
            {% endif %}
        </div>

        {# --- Filtres sous-catégorie --- #}
        {% if subCategories %}
            <nav class="subcats" aria-label="Filtrer par type">
                <a href="{{ path('front_category', { slug: category.slug }) }}"
                   class="chip {{ currentSubCategory is null ? 'is-active' }}">Tous</a>
                {% for sc in subCategories %}
                    <a href="{{ path('front_category', { slug: category.slug, 'sous-categorie': sc.slug }) }}"
                       class="chip {{ currentSubCategory and currentSubCategory.id == sc.id ? 'is-active' }}">{{ sc.name }}</a>
                {% endfor %}
            </nav>
        {% endif %}

        {# --- Grille produits (pagination = SEULEMENT les 12 de la page) --- #}
        <div class="grid-produits">
            {% for product in pagination %}
                {{ include('front/_product_card.html.twig', { product: product }) }}
            {% else %}
                <p class="empty">Aucun produit dans cette catégorie pour le moment.</p>
            {% endfor %}
        </div>

        {# --- Liens « ‹ 1 2 3 › » générés par KnpPaginator --- #}
        <div class="pagination">
            {{ knp_pagination_render(pagination) }}
        </div>

        {# --- Suite du texte de catégorie --- #}
        {% if paragraphes|length > 1 %}
            <div class="category-seo">
                {% for p in paragraphes|slice(1) %}
                    <p>{{ p|trim|nl2br }}</p>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>
{% endblock %}