{% extends 'front/base.html.twig' %}

{% block title %}{{ product.metaTitle ?? (product.name ~ ' — Brillance Home') }}{% endblock %}

{% block meta_description %}{{ product.metaDescription ?: (product.name ~ ' — découvrez ce produit chez Brillance Home à Bordeaux. Commande et conseil sur WhatsApp.') }}{% endblock %}

{% block og_type %}product{% endblock %}
{% block og_image %}{% if product.mainMedia %}{{ absolute_url(vich_uploader_asset(product.mainMedia, 'imageFile')|imagine_filter('galerie')) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block json_ld %}
    {# Toutes les photos, en adresses absolues — le slice renumérote la liste #}
    {% set images = product.media
        |map(m => absolute_url(vich_uploader_asset(m, 'imageFile')|imagine_filter('galerie')))
        |slice(0, product.media|length) %}
    {% set adresse = url('front_product', { slug: product.slug }) %}

    {% set produit = {
        '@type': 'Product',
        'name': product.name,
        'description': product.metaDescription ?: (product.description|striptags),
        'url': adresse,
        'sku': product.slug,
        'category': product.category.name,
        'brand': { '@type': 'Brand', 'name': 'Brillance Home' },
        'offers': {
            '@type': 'Offer',
            'price': product.actualPrice,
            'priceCurrency': 'EUR',
            'itemCondition': 'https://schema.org/NewCondition',
            'availability': product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/MadeToOrder',
            'url': adresse,
            'seller': { '@id': 'https://brillancehome.fr/#magasin' }
        }
    } %}
    {% if images|length %}
        {% set produit = produit|merge({ 'image': images }) %}
    {% endif %}
    {# Avec des variantes, une offre groupée : de la moins chère à la plus chère #}
    {% if product.variants|length %}
        {% set prix = product.variants|map(v => v.actualPrice) %}
        {% set produit = produit|merge({ 'offers': {
            '@type': 'AggregateOffer',
            'lowPrice': min(prix),
            'highPrice': max(prix),
            'offerCount': prix|length,
            'priceCurrency': 'EUR'
        } }) %}
    {% endif %}

    {% set fil = {
        '@type': 'BreadcrumbList',
        'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Accueil', 'item': url('front_home') },
            { '@type': 'ListItem', 'position': 2, 'name': product.category.name, 'item': url('front_category', { slug: product.category.slug }) },
            { '@type': 'ListItem', 'position': 3, 'name': product.name, 'item': adresse }
        ]
    } %}

    {# JSON_HEX_TAG : un « < » saisi dans un texte ne peut pas fermer la balise script #}
    <script type="application/ld+json">{{ { '@context': 'https://schema.org', '@graph': [produit, fil] }|json_encode(constant('JSON_HEX_TAG'))|raw }}</script>
{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap">

        {# Fil d'Ariane #}
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <a href="{{ path('front_home') }}">Accueil</a>
            <span aria-hidden="true">›</span>
            <a href="{{ path('front_category', { slug: product.category.slug }) }}">{{ product.category.name }}</a>
            <span aria-hidden="true">›</span>
            <span>{{ product.name }}</span>
        </nav>

        {# ===== 2 COLONNES ===== #}
        <div class="product">

            {# --- GAUCHE : galerie --- #}
            <div class="product-media">
                {% if product.media|length %}
                    <div class="gallery">
                        <div class="gal-stage">
                            <div class="gal-viewport">
                                {% for media in product.media %}
                                    {% if media.video %}
                                        {# Façade : la couverture et un bouton. L'iframe YouTube n'est construite qu'au clic. #}
                                        <div class="gal-video">
                                            <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('galerie') }}"
                                                 alt="{{ media.alt ?? product.name }}">
                                            <button type="button" class="gal-play" aria-label="Lire la vidéo"
                                                    data-facade="https://www.youtube-nocookie.com/embed/{{ media.videoId }}?autoplay=1&rel=0"
                                                    data-facade-title="Vidéo du produit">▶</button>
                                            <p class="gal-video-note">En lançant la lecture, la vidéo est chargée depuis YouTube, qui peut déposer des traceurs.</p>
                                        </div>
                                    {% else %}
                                        {# Un bouton : la photo s'ouvre en grand, au clic comme au clavier #}
                                        <button type="button" class="gal-photo" aria-haspopup="dialog"{% if not loop.first %} tabindex="-1"{% endif %}>
                                            <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('galerie') }}"
                                                 alt="{{ media.alt ?? product.name }}">
                                        </button>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            {% if product.media|length > 1 %}
                                <button type="button" class="gal-arrow gal-prev" aria-label="Photo précédente">‹</button>
                                <button type="button" class="gal-arrow gal-next" aria-label="Photo suivante">›</button>
                            {% endif %}
                        </div>
                        <div class="gal-thumbs">
                            {% for media in product.media %}
                                <button type="button" class="gal-thumb{{ loop.first ? ' is-active' }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" data-index="{{ loop.index0 }}">
                                    <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('vignette') }}"
                                         alt="{{ media.alt ?? product.name }}">
                                    {% if media.video %}<span class="gal-thumb-play" aria-hidden="true">▶</span>{% endif %}
                                </button>
                            {% endfor %}
                        </div>
                    </div>

                    {# Visionneuse plein écran, photos seules. Elle reprend les classes de la galerie :
                       flèches et défilement fonctionnent sans code en plus. #}
                    {% set photos = product.photos %}
                    {% if photos %}
                        <dialog class="gallery visionneuse" aria-label="Photos en grand">
                            <button type="button" class="panneau-close" aria-label="Fermer">✕</button>
                            <div class="gal-viewport">
                                {% for media in photos %}
                                    <div class="vis-cadre">
                                        <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('galerie') }}"
                                             alt="{{ media.alt ?? product.name }}">
                                    </div>
                                {% endfor %}
                            </div>
                            {% if photos|length > 1 %}
                                <button type="button" class="gal-arrow gal-prev" aria-label="Photo précédente">‹</button>
                                <button type="button" class="gal-arrow gal-next" aria-label="Photo suivante">›</button>
                            {% endif %}
                        </dialog>
                    {% endif %}
                {% endif %}
            </div>

            {# --- DROITE : infos --- #}
            <div class="product-info">

                <h1>{{ product.name }}</h1>

                {# Variante affichée : celle du lien ?taille=…&matiere=…, sinon la première. Une valeur
                   inconnue est ignorée. Sans variante, prix et stock sont ceux du produit. #}
                {% set demandees = product.variants|filter(v => v.size == tailleDemandee) %}
                {% set offre = demandees|filter(v => (v.fabric ~ '') == matiereDemandee)|first
                    ?: demandees|first ?: product.variants|first ?: product %}

                {# Prix barré et remise sont toujours écrits, masqués sans remise :
                   sur un produit à variantes, ils apparaissent quand on choisit une variante en promotion #}
                {% set remise = offre|remise %}
                <div class="price-row">
                    <span class="price">{{ offre.actualPrice|prix }}</span>
                    <del class="price-old"{{ remise ? '' : ' hidden' }}>{{ offre.initialPrice|prix }}</del>
                    <span class="price-remise"{{ remise ? '' : ' hidden' }}>-{{ remise }}&nbsp;%</span>
                </div>
                <p class="price-facilities">Paiement en 2, 3 ou 4 fois SANS FRAIS</p>

                {# Variantes : la taille, puis la matière parmi celles de cette taille, puis sa finition.
                   Leurs prix et leur disponibilité sont écrits ici : la fiche les suit sans appel au serveur.
                   Une matière se nomme avec sa référence (« Céramique (Premium) ») : deux matières peuvent porter le même nom. #}
                {% if product.variants|length %}
                    {% set tailles = product.variants|reduce((liste, v) => v.size and v.size not in liste ? liste|merge([v.size]) : liste, []) %}
                    {% set matieres = product.variants|reduce((liste, v) => v.fabric and v.fabric not in liste ? liste|merge([v.fabric]) : liste, []) %}
                    <div data-variantes="{{ product.variants|map(v => {
                        taille: v.size, matiere: v.fabric ? v.fabric ~ '' : null,
                        prix: v.actualPrice|prix, prixBarre: v.initialPrice|prix, remise: v|remise, enStock: v.stock > 0
                    })|json_encode }}">
                        {% if tailles|length %}
                            <div class="cfg-group">
                                <h3 class="cfg-title">Taille (cm) : <span class="cfg-choice">{{ offre.size }}</span></h3>
                                <div class="variant-row">
                                    {% for taille in tailles %}
                                        <button type="button" class="variant-chip taille-opt{{ taille == offre.size ? ' is-active' }}" aria-pressed="{{ taille == offre.size ? 'true' : 'false' }}" data-choix="{{ taille }}">
                                            <span class="variant-dim">{{ taille }}</span>
                                        </button>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        {% if matieres|length %}
                            <div class="cfg-group">
                                <h3 class="cfg-title">Matière : <span class="cfg-choice">{{ offre.fabric }}</span></h3>
                                <div class="variant-row">
                                    {% for matiere in matieres %}
                                        <button type="button" class="variant-chip matiere-opt{{ matiere is same as offre.fabric ? ' is-active' }}" aria-pressed="{{ matiere is same as offre.fabric ? 'true' : 'false' }}" data-choix="{{ matiere }}"
                                                {{- product.variants|filter(v => v.size == offre.size and v.fabric is same as matiere)|length ? '' : ' hidden' }}>
                                            <span class="variant-dim">{{ matiere }}</span>
                                        </button>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        {# Finitions de la matière choisie, sans effet sur le prix : seul leur nuancier est visible.
                           Une matière sans finition n'a pas cette étape. #}
                        {% for matiere in matieres|filter(m => m.fabricColors|length) %}
                            <div class="cfg-group swatch-group nuancier-group{{ matiere is same as offre.fabric ? ' is-visible' }}" data-finitions="{{ matiere }}">
                                <h3 class="cfg-title">Finition : <span class="cfg-choice">{{ matiere.fabricColors|first.name }}</span></h3>
                                {{ include('front/_nuancier.html.twig', {
                                    fabric: matiere,
                                    panneau: 'finitions-' ~ matiere.id,
                                    titre: 'Choisir une finition',
                                    legende: matiere ~ ' · ' ~ matiere.fabricColors|length ~ ' finitions'
                                }) }}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Configurateur : swatches avec révélation « +N » #}
                    {% if product.fabrics|length %}
                        {% set maxFabrics = 3 %}
                        <div class="cfg-group swatch-group">
                            <h3 class="cfg-title">Tissu : <span class="cfg-choice">{{ product.fabrics|first.name }}</span></h3>
                            <div class="mat-row">
                                {% for fabric in product.fabrics %}
                                    <button type="button" class="mat-opt{{ loop.first ? ' is-active' }}{{ loop.index0 >= maxFabrics ? ' swatch-extra' }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                            data-choix="{{ fabric.name }}" data-fabric-id="{{ fabric.id }}">{{ fabric }}</button>
                                {% endfor %}
                                {% if product.fabrics|length > maxFabrics %}
                                    <button type="button" class="swatch-more" data-panneau="tissus-{{ product.id }}">+{{ product.fabrics|length - maxFabrics }}</button>
                                {% endif %}
                            </div>

                            {# Panneau : tous les tissus du produit #}
                            <dialog class="nuancier-panneau" id="tissus-{{ product.id }}">
                                <div class="panneau-in">
                                    <div class="panneau-head">
                                        <div>
                                            <h2>Choisir un tissu</h2>
                                            <p>{{ product.fabrics|length }} tissus disponibles</p>
                                        </div>
                                        <button type="button" class="panneau-close" aria-label="Fermer">✕</button>
                                    </div>
                                    <div class="panneau-body">
                                        <div class="panneau-liste">
                                            {% for fabric in product.fabrics %}
                                                <button type="button" class="panneau-ligne{{ loop.first ? ' is-active' }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}" data-fabric-id="{{ fabric.id }}">
                                                    <span class="ligne-nom">{{ fabric.name }}</span>
                                                    {% if fabric.fabricColors|length %}
                                                        <span class="ligne-info">{{ fabric.fabricColors|length }} coloris</span>
                                                    {% endif %}
                                                </button>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </dialog>
                        </div>
                        {# Un nuancier par tissu — seul celui du tissu actif est visible #}
                        {% for fabric in product.fabrics %}
                            {% if fabric.fabricColors|length %}
                                <div class="cfg-group swatch-group nuancier-group{{ loop.first ? ' is-visible' }}" data-nuancier="{{ fabric.id }}">
                                    <h3 class="cfg-title">Coloris : <span class="cfg-choice">{{ fabric.fabricColors|first.name }}</span></h3>
                                    {{ include('front/_nuancier.html.twig', {
                                        panneau: 'nuancier-' ~ fabric.id,
                                        titre: 'Choisir un coloris',
                                        legende: fabric.name ~ ' · ' ~ fabric.fabricColors|length ~ ' coloris'
                                    }) }}
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                {# Finitions : uniquement pour les produits SANS tissu (bois, laque, métal) #}
                    {% if product.colors|length and product.fabrics|length == 0 %}
                        <div class="cfg-group swatch-group nuancier-group is-visible">
                            <h3 class="cfg-title">Finition : <span class="cfg-choice">{{ product.colors|first.name }}</span></h3>
                            <div class="col-row">
                                {% for color in product.colors %}
                                    <button type="button" class="col-dot{{ loop.first ? ' is-active' }}" aria-pressed="{{ loop.first ? 'true' : 'false' }}"
                                            style="background: {{ color.hex }}"
                                            data-choix="{{ color.name }}" aria-label="{{ color.name }}" title="{{ color.name }}"></button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                {# Variantes : une touche par configuration, chacune menant à sa fiche.
                   Pas sur un produit à variantes : sa taille ou sa matière se choisit plus haut (décision du 4/11). #}
                {% set variants = product.family and product.isModular.value != 'module' and product.variants is empty
                    ? product.family.products|filter(v => v.isActive and v.isModular.value != 'module')|sort((a, b) => a.position - b.position)
                    : [] %}
                {% if variants|length > 1 %}
                    {# Libellé des touches : si le nom contient une dimension (140x200, 160*200, 180×200),
                       on n'affiche qu'elle. Sinon — canapés, modules — on garde le nom complet. #}
                    {% set motif = '/^\\d{2,3}[x×*]\\d{2,3}$/ui' %}
                    {% set dimActuelle = product.name|split(' ')|filter(m => m matches motif) %}
                    {% set maxVariants = 4 %}
                    {# Si la configuration affichée est au-delà des 4 premières, on ouvre d'emblée :
                       sinon sa touche serait masquée et rien ne paraîtrait sélectionné. #}
                    {% set deplie = product.id not in variants|slice(0, maxVariants)|map(v => v.id) %}
                    <div class="cfg-group swatch-group{{ deplie ? ' is-expanded' }}">
                        <h3 class="cfg-title">Configuration : <span class="cfg-choice">{{ dimActuelle|length ? dimActuelle|first : product.name }}</span></h3>
                        <div class="variant-row">
                            {% for v in variants %}
                                {% set dim = v.name|split(' ')|filter(m => m matches motif) %}
                                <a href="{{ path('front_product', { slug: v.slug }) }}"
                                   class="variant-chip{{ v.id == product.id ? ' is-active' }}{{ loop.index0 >= maxVariants ? ' swatch-extra' }}"
                                   {{ v.id == product.id ? 'aria-current="page"' }}>
                                    <span class="variant-dim">{{ dim|length ? dim|first : v.name }}</span>
                                    <span class="variant-price">{{ v.actualPrice|prix }}</span>
                                </a>
                            {% endfor %}
                            {% if variants|length > maxVariants %}
                                <button type="button" class="swatch-more">+{{ variants|length - maxVariants }}</button>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Buybox épurée : réassurance + CTA #}
                <div class="buybox">
                    {# En stock : « Disponible immédiatement ». Sinon, le délai de fabrication, que les variantes
                       affichent toujours. Sur un produit à variantes, on voit la mention de la variante choisie. #}
                    {% set enStock = offre.stock > 0 %}
                    <p class="buybox-lead dispo-stock"{{ enStock ? '' : ' hidden' }}><i class="fa-solid fa-check"></i> Disponible immédiatement</p>
                    {% if product.isCustomMade or product.variants|length %}
                        <p class="buybox-lead dispo-commande"{{ enStock ? ' hidden' }}><i class="fa-regular fa-clock"></i>
                            Fabriqué sur commande{% if product.leadMinWeeks and product.leadMaxWeeks %} · livraison sous {{ product.leadMinWeeks }} à {{ product.leadMaxWeeks }} semaines{% endif %}
                        </p>
                    {% endif %}

                    <a class="btn btn-wa btn-devis" data-wa="{{ whatsapp_number }}" data-product="{{ product.name }}"
                       href="https://wa.me/{{ whatsapp_number }}?text={{ ('Bonjour, je suis intéressée par le ' ~ product.name ~ '. Je souhaite le commander.')|url_encode }}"
                       target="_blank" rel="noopener">
                       <i class="fa-brands fa-whatsapp"></i> Commander sur WhatsApp
                    </a>
                </div>


                {# Accordéons #}
                <div class="accordions">
                    {% if product.description %}
                        <details class="accord">
                            <summary>Description</summary>
                            <p>{{ product.description|nl2br }}</p>
                        </details>
                    {% endif %}
                    {% if product.dimension %}
                        <details class="accord">
                            <summary>Dimensions &amp; caractéristiques</summary>
                            <p>{{ product.dimension|nl2br }}</p>
                        </details>
                    {% endif %}
                    <details class="accord">
                        <summary>Livraison</summary>
                        <p>Fabrication sur commande, puis livraison et installation partout en France. Le tarif dépend du volume et de la destination : il vous est communiqué avec votre devis.</p>
                    </details>
                </div>

            </div>

        </div>

        {# Encadré devis sur-mesure — pas pour un module : ses dimensions sont fixes #}
        {% if product.isModular.value != 'module' %}
            <div class="custom-quote">
                <p><strong>Une taille non listée ?</strong> <label for="dimensions">Indiquez vos dimensions</label>, on vous envoie un devis sous 24h.</p>
                <input type="text" class="quote-dims" id="dimensions" placeholder="Ex. L 250 × P 100 × H 85 cm">
                <button type="button" class="btn btn-wa btn-quote" data-wa="{{ whatsapp_number }}" data-product="{{ product.name }}">
                    <i class="fa-brands fa-whatsapp"></i> Demander un devis
                </button>
            </div>
        {% endif %}

        {# Réassurance : 3 encadrés alignés #}
        <div class="reassurance-grid">
            <div class="reassurance-card">
                <i class="fa-solid fa-shield-halved"></i>
                <h3>Garantie</h3>
                <p>Meubles garantis, structure et finitions soignées pour durer.</p>
            </div>
            <div class="reassurance-card">
                <i class="fa-solid fa-ruler-combined"></i>
                <h3>Fabrication sur-mesure</h3>
                <p>Sur commande, adaptée à vos dimensions et à votre intérieur.</p>
            </div>
            <div class="reassurance-card">
                <i class="fa-solid fa-credit-card"></i>
                <h3>Paiement facilité</h3>
                <p>Réglez en 2, 3 ou 4 fois SANS FRAIS.</p>
            </div>
        </div>

        {# Composition d'un canapé modulable, module par module, à partir de zéro. Sur toutes les fiches
           de la gamme (ensembles et modules), les mêmes modules visibles : ceux de la famille, dans l'ordre
           du glisser-déposer. Un ensemble sans famille garde les siens. #}
        {% set modulesVisibles = (product.family and product.isModular.value != 'no'
                ? product.family.products|filter(p => p.isModular.value == 'module')
                : product.modules)
            |filter(m => m.isActive)|sort((a, b) => (a.position - b.position) ?: (a.id - b.id)) %}
        {% if modulesVisibles|length %}
        {% set nomGamme = product.family.name ?? product.name %}
        <section class="modules-produit composition" data-gamme="{{ nomGamme }}">
            <h2>Composez votre {{ nomGamme }}</h2>
            <p class="modules-intro">
                Ajoutez les modules de votre choix, le total se calcule à mesure. Cliquez sur un module pour découvrir ses dimensions.
            </p>
            <div class="grid-produits">
                {% for module in modulesVisibles %}
                    {# La composition part de celle de la photo : les modules choisis dans l'admin #}
                    {% set nb = module in product.modules ? 1 : 0 %}
                    <div class="compo-module" data-nom="{{ module.name }}" data-prix="{{ module.actualPrice }}">
                        {{ include('front/_product_card.html.twig', { product: module }) }}
                        <div class="compo-qte">
                            <button type="button" class="compo-moins" aria-label="Retirer {{ module.name }}" aria-disabled="{{ nb ? 'false' : 'true' }}">−</button>
                            <span class="compo-nb" data-initial="{{ nb }}">{{ nb }}</span>
                            <button type="button" class="compo-plus" aria-label="Ajouter {{ module.name }}" aria-disabled="false">+</button>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="compo-recap">
                <div role="status" aria-live="polite">
                    <ul class="compo-liste"></ul>
                    <p class="compo-somme">Total : <strong class="compo-total">{{ 0|prix }}</strong></p>
                </div>
                <p class="compo-mention">Un conseiller valide avec vous la faisabilité de votre composition.</p>
                <button type="button" class="btn btn-wa compo-commander" data-wa="{{ whatsapp_number }}" disabled>
                    <i class="fa-brands fa-whatsapp"></i> Commander cette composition sur WhatsApp
                </button>
            </div>
        </section>
        {% endif %}

        {# Fiche d'un module : on mène aussi vers les canapés de la gamme #}
        {% if product.isModular.value == 'module' and product.family %}
            {% set canapesGamme = product.family.products|filter(p => p.isActive and p.isModular.value != 'module')|sort((a, b) => (a.position - b.position) ?: (a.id - b.id)) %}

            {% if canapesGamme|length %}
            <section class="modules-produit">
                <h2>Les canapés {{ product.family.name }}</h2>
                <p class="modules-intro">Les compositions de la gamme, prêtes à commander.</p>
                <div class="grid-produits">
                    {% for canape in canapesGamme %}
                        {{ include('front/_product_card.html.twig', { product: canape }) }}
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        {% endif %}
        
        {% if similar and product.isModular.value != 'module' %}
        <section class="similar">
            <h2>Vous aimerez aussi</h2>
            <div class="grid-produits">
                {% for p in similar %}
                    {{ include('front/_product_card.html.twig', { product: p }) }}
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </div>
</section>
{% endblock %}