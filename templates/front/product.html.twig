{% extends 'front/base.html.twig' %}

{% block title %}{{ product.metaTitle ?? (product.name ~ ' — Brillance Home') }}{% endblock %}

{% block meta_description %}{{ product.metaDescription ?: (product.name ~ ' — découvrez ce produit chez Brillance Home à Bordeaux. Devis gratuit sur WhatsApp.') }}{% endblock %}

{% block json_ld %}
    {% set data = {
        '@context': 'https://schema.org',
        '@type': 'Product',
        'name': product.name,
        'description': product.metaDescription ?: (product.description|striptags),
        'brand': { '@type': 'Brand', 'name': 'Brillance Home' },
        'offers': {
            '@type': 'Offer',
            'price': product.actualPrice,
            'priceCurrency': 'EUR',
            'availability': product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/PreOrder',
            'url': app.request.uri
        }
    } %}
    {% if product.mainMedia %}
        {% set data = data|merge({ 'image': app.request.schemeAndHttpHost ~ (vich_uploader_asset(product.mainMedia, 'imageFile')|imagine_filter('galerie')) }) %}
    {% endif %}
    <script type="application/ld+json">{{ data|json_encode|raw }}</script>
{% endblock %}

{% block body %}
<section class="section">
    <div class="wrap">

        {# Fil d'Ariane #}
        <nav class="breadcrumb" aria-label="Fil d'Ariane">
            <a href="{{ path('front_home') }}">Accueil</a>
            <span aria-hidden="true">›</span>
            <a href="{{ path('front_category', { slug: product.category.slug }) }}">{{ product.category.name }}</a>
            <span aria-hidden="true">›</span>
            <span>{{ product.name }}</span>
        </nav>

        {# ===== 2 COLONNES ===== #}
        <div class="product">

            {# --- GAUCHE : galerie --- #}
            <div class="product-media">
                {% if product.media|length %}
                    <div class="gallery">
                        <div class="gal-stage">
                            <div class="gal-viewport">
                                {% for media in product.media %}
                                    <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('galerie') }}"
                                         alt="{{ media.alt ?? product.name }}">
                                {% endfor %}
                            </div>
                            {% if product.media|length > 1 %}
                                <button type="button" class="gal-arrow gal-prev" aria-label="Photo précédente">‹</button>
                                <button type="button" class="gal-arrow gal-next" aria-label="Photo suivante">›</button>
                            {% endif %}
                        </div>
                        <div class="gal-thumbs">
                            {% for media in product.media %}
                                <button type="button" class="gal-thumb{{ loop.first ? ' is-active' }}" data-index="{{ loop.index0 }}">
                                    <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('vignette') }}"
                                         alt="{{ media.alt ?? product.name }}">
                                </button>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            {# --- DROITE : infos --- #}
            <div class="product-info">

                <h1>{{ product.name }}</h1>

                <div class="price-row">
                    {% if product.actualPrice < product.initialPrice %}
                        <span class="price">{{ product.actualPrice }} €</span>
                        <del class="price-old">{{ product.initialPrice }} €</del>
                    {% else %}
                        <span class="price">{{ product.actualPrice }} €</span>
                    {% endif %}
                </div>
                <p class="price-facilities">Paiement en 2, 3 ou 4 fois SANS FRAIS</p>

                {# Configurateur : swatches avec révélation « +N » #}
                <div class="config">
                    {% if product.fabrics|length %}
                        {% set maxFabrics = 4 %}
                        <div class="cfg-group swatch-group">
                            <h3 class="cfg-title">Tissu : <span class="cfg-choice" data-choice="fabric">{{ product.fabrics|first.name }}</span></h3>
                            <div class="mat-row">
                                {% for fabric in product.fabrics %}
                                    <button type="button" class="mat-opt{{ loop.first ? ' is-active' }}{{ loop.index0 >= maxFabrics ? ' swatch-extra' }}" data-fabric="{{ fabric.name }}">{{ fabric.name }}</button>
                                {% endfor %}
                                {% if product.fabrics|length > maxFabrics %}
                                    <button type="button" class="swatch-more">+{{ product.fabrics|length - maxFabrics }}</button>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {% if product.colors|length %}
                        {% set maxColors = 6 %}
                        <div class="cfg-group swatch-group">
                            <h3 class="cfg-title">Coloris : <span class="cfg-choice" data-choice="color">{{ product.colors|first.name }}</span></h3>
                            <div class="col-row">
                                {% for color in product.colors %}
                                    <button type="button" class="col-dot{{ loop.first ? ' is-active' }}{{ loop.index0 >= maxColors ? ' swatch-extra' }}"
                                            style="background: {{ color.hex starts with '#' ? color.hex : '#' ~ color.hex }}"
                                            data-color="{{ color.name }}" aria-label="{{ color.name }}" title="{{ color.name }}"></button>
                                {% endfor %}
                                {% if product.colors|length > maxColors %}
                                    <button type="button" class="swatch-more">+{{ product.colors|length - maxColors }}</button>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Variantes : menu déroulant #}
                {% set variants = product.family ? product.family.products|filter(v => v.isActive) : [] %}
                {% if variants|length > 1 %}
                    <div class="cfg-group">
                        <h3 class="cfg-title">Configuration</h3>
                        <select class="variant-select" aria-label="Choisir une configuration">
                            {% for v in variants %}
                                <option value="{{ path('front_product', { slug: v.slug }) }}" {{ v.id == product.id ? 'selected' }}>{{ v.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}

                {# Buybox épurée : réassurance + CTA #}
                <div class="buybox">
                    {% if product.isCustomMade %}
                        <p class="buybox-lead"><i class="fa-regular fa-clock"></i>
                            Fabriqué sur commande{% if product.leadMinWeeks and product.leadMaxWeeks %} · livraison sous {{ product.leadMinWeeks }} à {{ product.leadMaxWeeks }} semaines{% endif %}
                        </p>
                    {% endif %}

                    <a class="btn-devis" data-wa="{{ whatsapp_number }}" data-product="{{ product.name }}"
                       href="https://wa.me/{{ whatsapp_number }}?text={{ ('Bonjour, je suis intéressée par le ' ~ product.name ~ '. Pouvez-vous me faire un devis ?')|url_encode }}"
                       target="_blank" rel="noopener">
                        <i class="fa-brands fa-whatsapp"></i> Demander un devis sur WhatsApp
                    </a>
                </div>


                {# Accordéons #}
                <div class="accordions">
                    {% if product.description %}
                        <details class="accord" open>
                            <summary>Description</summary>
                            <p>{{ product.description|nl2br }}</p>
                        </details>
                    {% endif %}
                    {% if product.dimension %}
                        <details class="accord">
                            <summary>Dimensions &amp; caractéristiques</summary>
                            <p>{{ product.dimension|nl2br }}</p>
                        </details>
                    {% endif %}
                    <details class="accord">
                        <summary>Livraison &amp; entretien</summary>
                        <p>Fabrication sur commande, puis livraison. Montage compris en Gironde. Entretien : brossage doux, nettoyage délicat.</p>
                    </details>
                </div>

            </div>

        </div>

        {# Encadré devis sur-mesure #}
        <div class="custom-quote">
            <p><strong>Une taille non listée ?</strong> Indiquez vos dimensions, on vous envoie un devis sous 24h.</p>
            <input type="text" class="quote-dims" placeholder="Ex. L 250 × P 100 × H 85 cm">
            <button type="button" class="btn-quote" data-wa="{{ whatsapp_number }}" data-product="{{ product.name }}">
                <i class="fa-brands fa-whatsapp"></i> Demander un devis
            </button>
        </div>

        {# Réassurance : 3 encadrés alignés #}
        <div class="reassurance-grid">
            <div class="reassurance-card">
                <i class="fa-solid fa-shield-halved"></i>
                <h3>Garantie</h3>
                <p>Meubles garantis, structure et finitions soignées pour durer.</p>
            </div>
            <div class="reassurance-card">
                <i class="fa-solid fa-ruler-combined"></i>
                <h3>Fabrication sur-mesure</h3>
                <p>Sur commande, adaptée à vos dimensions et à votre intérieur.</p>
            </div>
            <div class="reassurance-card">
                <i class="fa-solid fa-credit-card"></i>
                <h3>Paiement facilité</h3>
                <p>Réglez en 2, 3 ou 4 fois sans frais.</p>
            </div>
        </div>
    </div>
</section>
{% endblock %}