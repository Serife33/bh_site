
{# Carte produit réutilisable. Attend une variable "product", et en_avant (facultatif) pour la grande carte : photo plus grande et bouton. #}
{% set en_avant = en_avant|default(false) %}
{% set format = en_avant ? 'univers' : 'vignette' %}
<a href="{{ path('front_product', { slug: product.slug }) }}" class="pcard">
    <div class="pcard-photo">
        {% set photo = product.mainMedia %}
        {% set survol = product.hoverMedia %}
        {% if photo %}
            <img src="{{ vich_uploader_asset(photo, 'imageFile') | imagine_filter(format) }}"
                 alt="{{ photo.alt ?? product.name }}" loading="{{ eager|default(false) ? 'eager' : 'lazy' }}">
            {% if survol %}
                {# Décorative : la première image porte déjà la description du produit #}
                <img class="pcard-survol"
                     src="{{ vich_uploader_asset(survol, 'imageFile') | imagine_filter(format) }}"
                     alt="" aria-hidden="true" loading="lazy">
            {% endif %}
        {% endif %}

        {% if product.actualPrice < product.initialPrice %}
            <span class="pcard-badge promo">-{{ product|remise }}&nbsp;%</span>
        {% elseif product.stock > 0 %}
            <span class="pcard-badge stock">En stock</span>
        {% endif %}
    </div>
    <div class="pcard-info">
        <div class="pcard-name">{{ product.name }}</div>
        <div class="pcard-price">
            {# Le prix affiché est celui de la variante la moins chère : « à partir de » si d'autres coûtent plus #}
            {% if product.variants|filter(v => v.actualPrice != product.actualPrice)|length %}
                <span class="pcard-from">à partir de</span>
            {% endif %}
            {% if product.actualPrice < product.initialPrice %}
                <span class="promo">{{ product.actualPrice|prix }}</span>
                <del>{{ product.initialPrice|prix }}</del>
            {% else %}
                {{ product.actualPrice|prix }}
            {% endif %}
        </div>
        {% if en_avant %}<span class="pcard-voir">Voir le produit</span>{% endif %}
    </div>
</a>
