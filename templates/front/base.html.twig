
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Brillance Home{% endblock %}</title>
    {# Adresse de référence de la page — évite que les variantes filtrées ou paginées se concurrencent #}
    <link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">
    <meta name="description" content="{% block meta_description %}Brillance Home — spécialiste de l'ameublement intérieur à Bordeaux : salon, salle à manger, chambre et literie.{% endblock %}">

    {# Aperçu des liens partagés #}
    <meta property="og:site_name" content="Brillance Home">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('meta_description') }}">
    <meta property="og:url" content="{{ block('canonical') }}">
    <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/partage.jpg')) }}{% endblock %}">
    <meta name="twitter:card" content="summary_large_image">

    {# Favicon #}
    <link rel="icon" type="image/png" href="{{ asset('favicon-96x96.png') }}" sizes="96x96">
    <link rel="icon" type="image/svg+xml" href="{{ asset('favicon.svg') }}">
    <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <meta name="robots" content="max-image-preview:large">

    {# Polices Google : Jost (logo) + Montserrat (interface et texte) #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

    {# Charge le CSS compilé (via AssetMapper) #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {{ importmap('app') }}
    {% endblock %}

    {# Données structurées du magasin — sur toutes les pages #}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "FurnitureStore",
          "@id": "https://brillancehome.fr/#magasin",
          "name": "Brillance Home",
          "url": "https://brillancehome.fr",
          "logo": "{{ absolute_url(asset('images/logo.png')) }}",
          "image": "{{ absolute_url(asset('images/partage.jpg')) }}",
          "description": "Magasin de meubles à Bordeaux : canapés, lits coffres, matelas, tables et chaises. Tissu et coloris au choix sans supplément, fabrication sur commande.",
          "telephone": "+33781071071",
          "priceRange": "€€",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "12 bis rue Suffren",
            "postalCode": "33300",
            "addressLocality": "Bordeaux",
            "addressRegion": "Nouvelle-Aquitaine",
            "addressCountry": "FR"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 44.875289,
            "longitude": -0.557280
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
              "opens": "11:00",
              "closes": "18:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": "Sunday",
              "opens": "14:00",
              "closes": "17:00"
            }
          ],
          "areaServed": [
            { "@type": "City", "name": "Bordeaux" },
            { "@type": "AdministrativeArea", "name": "Gironde" },
            { "@type": "Country", "name": "France" }
          ],
          "sameAs": [
            "https://www.instagram.com/brillancehome",
            "https://www.tiktok.com/@brillancehome"
          ]
        },
        {
          "@type": "WebSite",
          "@id": "https://brillancehome.fr/#site",
          "name": "Brillance Home",
          "url": "https://brillancehome.fr",
          "inLanguage": "fr-FR",
          "publisher": { "@id": "https://brillancehome.fr/#magasin" }
        }
      ]
    }
    </script>

    {% block json_ld %}{% endblock %}
</head>


<body>
    {{ include('front/_band.html.twig') }}

    <header class="hdr">
        <div class="hdr-in wrap">
            <a href="{{ path('front_home') }}" class="logo">
                <img src="{{ asset('images/logo.png') }}" alt="" aria-hidden="true">
                <span class="logo-text">Brillance Home</span>
            </a>

            <nav class="nav" id="main-nav">
                <a href="{{ path('front_home') }}">Accueil</a>

                <div class="nav-univers">
                    <a href="#univers" class="nav-univers-btn">Nos univers <i class="fa-solid fa-chevron-down"></i></a>
                    <div class="nav-univers-menu">
                        {% for categorie in nav_categories() %}
                            <a href="{{ path('front_category', { slug: categorie.slug }) }}">{{ categorie.name }}</a>
                        {% endfor %}
                    </div>
                </div>

                <a href="{{ path('front_contact') }}">Contact</a>
            </nav>

            <div class="hdr-actions">
                <a href="{{ path('front_search') }}" class="hdr-search" aria-label="Rechercher"><i class="fa-solid fa-magnifying-glass"></i></a>
                <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="main-nav">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main class="main">
        {# Le contenu de chaque page viendra ici #}
        {% block body %}{% endblock %}
    </main>

    <footer class="ft">
        <div class="wrap ft-in">
            <div class="ft-col">
                <div class="ft-brand">Brillance Home</div>
                <p>Spécialiste de l'ameublement intérieur à Bordeaux — salon, salle à manger, chambre et literie pour toute la maison.</p>
            </div>
            <div class="ft-col">
                <h4>Showroom</h4>
                <p>12 bis rue Suffren</p>
                <p>33300 Bordeaux</p>
                <p><a href="tel:+33781071071">07 81 07 10 71</a></p>
                <p><a href="tel:+33695324151">06 95 32 41 51</a></p>
                <p>Lun–Sam · 11h–18h</p>
                <p>Dimanche · 14h–17h</p>
            </div>
            <div class="ft-col">
                <h4>Aide</h4>
                <a href="{{ path('front_contact') }}">Contact</a>
                <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">WhatsApp</a>
            </div>
        </div>
        <div class="ft-copy wrap">
            <span>© Brillance Home 2026 · Spécialiste de l'ameublement intérieur · Bordeaux, France</span>
            <span class="ft-legal">
                <a href="{{ path('front_mentions_legales') }}">Mentions légales</a>
                <a href="{{ path('front_confidentialite') }}">Politique de confidentialité</a>
            </span>
        </div>
    </footer>

    {# Bouton WhatsApp flottant (présent sur toutes les pages) #}
    <a href="https://wa.me/{{ whatsapp_number }}?text={{ 'Bonjour, je souhaite un renseignement.'|url_encode }}"
        class="wa-float"
        target="_blank"
        rel="noopener"
        aria-label="Poser une question sur WhatsApp">
        <i class="fa-brands fa-whatsapp"></i>
    </a>
    
    {{ include('front/_cookie_banner.html.twig') }}
</body>
</html>