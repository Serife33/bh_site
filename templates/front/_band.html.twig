{# Bandeau défilant, géré dans l'admin (menu Bandeau) : les messages visibles ce jour, promos d'abord.
   Ils sont listés UNE fois, bouclés DEUX fois pour la boucle sans couture. Aucun message : pas de bandeau. #}
{% set annonces = band_announcements() %}

{% if annonces %}
    <div class="band">
        <div class="band-track">
            {# le second passage est la duplication pour la boucle sans couture #}
            {% for passage in 1..2 %}
                {% for annonce in annonces %}
                    <span class="{{ annonce.isPromo ? 'band-promo' : '' }}">
                        {%- if annonce.link -%}
                            {# un lien https mène hors du site : nouvel onglet, sans accès à cette page #}
                            <a href="{{ annonce.link }}"{% if annonce.link starts with 'https://' %} target="_blank" rel="noopener"{% endif %}>{{ annonce.text }}</a>
                        {%- else -%}
                            {{ annonce.text }}
                        {%- endif -%}
                    </span>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
{% endif %}
