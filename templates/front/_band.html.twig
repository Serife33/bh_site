{# Bandeau défilant. Les messages sont listés UNE fois, bouclés DEUX fois pour la boucle sans couture. #}
{% set annonces = [
    { text: "Livraison partout en France" },
    { text: 'Paiement en 2, 3 ou 4 fois sans frais' },
    { text: 'Showroom : 12 bis rue Suffren, 33300 Bordeaux' },
    { text: 'Tissu, couleur et dimension au choix' },
] %}

{# Offre datée : affichée seulement pendant sa période, à l'heure de Paris (le projet ne fixe aucun fuseau).
   Les dates au format Y-m-d se comparent comme du texte. #}
{% set aujourdhui = 'now'|date('Y-m-d', 'Europe/Paris') %}
{% if aujourdhui >= '2026-11-06' and aujourdhui <= '2026-11-08' %}
    {% set annonces = [{ text: '-10 % sur tout le magasin du 6 au 8 novembre', type: 'promo' }]|merge(annonces) %}
{% endif %}

<div class="band">
    <div class="band-track">
        {% for annonce in annonces %}
            <span class="{{ annonce.type|default('') == 'promo' ? 'band-promo' : '' }}">{{ annonce.text }}</span>
        {% endfor %}
        {# duplication pour la boucle sans couture #}
        {% for annonce in annonces %}
            <span class="{{ annonce.type|default('') == 'promo' ? 'band-promo' : '' }}">{{ annonce.text }}</span>
        {% endfor %}
    </div>
</div>