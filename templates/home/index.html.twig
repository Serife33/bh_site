{% extends 'front/base.html.twig' %}

{% block title %}Brillance Home — Ameublement intérieur à Bordeaux{% endblock %}

{% block body %}
    {# ===== HERO ===== #}
    <section class="hero">
        <div class="wrap hero-in">
            <p class="hero-eyebrow">Showroom à Bordeaux</p>
            <h1 class="hero-title">Spécialiste de l'ameublement intérieur.</h1>
            <p class="hero-sub">Salon, salle à manger, chambre et literie — pensés pour toute la maison. Devis rapide sur WhatsApp.</p>
            <div class="hero-btns">
                <a href="#univers" class="btn btn-primary">Découvrir nos univers</a>
                <a href="https://wa.me/{{ whatsapp_number }}" class="btn btn-wa" target="_blank" rel="noopener">Parler à un conseiller</a>
            </div>
        </div>
    </section>

    {# ===== NOS UNIVERS (catégories) ===== #}
    <section class="section">
        <div class="wrap" id="univers">
            <div class="section-head">
                <h2>Nos univers</h2>
                <p>Explorez notre mobilier par catégorie</p>
            </div>
            <div class="cats">
                {% for categorie in categories %}
                    <a href="{{ path('front_home') }}" class="cat">
                        <div class="cat-ring"></div>
                        <span class="cat-name">{{ categorie.name }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===== 3 · PRODUITS : Nouveautés ===== #}
    {{ include('front/_product_section.html.twig', {
        titre: 'Nouveautés',
        sous_titre: 'Nos dernières pièces arrivées',
        products: nouveautes
    }) }}

    {{ include('front/_reassurance.html.twig') }}

    {# ===== 5 · PRODUITS : Promotions ===== #}
    {{ include('front/_product_section.html.twig', {
        titre: 'Promotions',
        sous_titre: 'Nos offres du moment',
        products: promos
    }) }}

    {{ include('front/_expertise.html.twig') }}

    {# ===== 7 · PRODUITS : Disponible immédiatement ===== #}
    {{ include('front/_product_section.html.twig', {
        titre: 'Disponible immédiatement',
        sous_titre: 'En stock, livraison rapide',
        products: enStock
    }) }}

    {{ include('front/_showroom.html.twig') }}

    {{ include('front/_faq.html.twig') }}

    {{ include('front/_cta_whatsapp.html.twig') }}

{% endblock %}