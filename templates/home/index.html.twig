{% extends 'front/base.html.twig' %}

{% block title %}Brillance Home — Ameublement intérieur à Bordeaux{% endblock %}

{% block body %}
    {# ===== HERO ===== #}
    <section class="hero">
        <div class="wrap hero-in">
            <p class="hero-eyebrow">Showroom à Bordeaux</p>
            <h1 class="hero-title">Spécialiste de l'ameublement intérieur.</h1>
            <p class="hero-sub">Salon, salle à manger, chambre et literie — pensés pour toute la maison. Devis rapide sur WhatsApp.</p>
            <div class="hero-btns">
                <a href="#univers" class="btn btn-primary">Découvrir nos univers</a>
                <a href="https://wa.me/{{ whatsapp_number }}" class="btn btn-wa" target="_blank" rel="noopener">Parler à un conseiller</a>
            </div>
        </div>
    </section>

    {# ===== NOS UNIVERS (catégories) : bande qui défile au doigt, flèches à partir de 900 px ===== #}
    <section class="section" id="univers">
        <div class="wrap section-tete">
            <div class="section-head">
                <h2>Nos univers</h2>
                <p>Explorez notre mobilier par catégorie</p>
            </div>
            <div class="fleches">
                <button type="button" class="fleche" data-sens="-1" aria-controls="bande-univers" aria-label="Univers précédents">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
                </button>
                <button type="button" class="fleche" data-sens="1" aria-controls="bande-univers" aria-label="Univers suivants">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                </button>
            </div>
        </div>
        <ul class="univers" id="bande-univers">
            {% for categorie in categories %}
                <li>
                    <a href="{{ path('front_category', { slug: categorie.slug }) }}">
                        {# Décorative : le nom de la catégorie, juste dessous, est le texte du lien #}
                        <span class="cadre cadre-haut">
                            {% if categorie.image %}
                                <img src="{{ vich_uploader_asset(categorie, 'imageFile') | imagine_filter('univers') }}" alt="" loading="lazy">
                            {% endif %}
                        </span>
                        <span>{{ categorie.name }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>

    {# ===== PRODUITS : les sections choisies dans l'admin, entrecoupées des blocs fixes ===== #}
    {# Réassurance après la 1re section, expertise après la 2e. Avec moins de sections, les blocs restants suivent. #}
    {% set blocs = ['front/_reassurance.html.twig', 'front/_expertise.html.twig'] %}
    {% for section in sections %}
        {{ include('front/_product_section.html.twig', {
            titre: section.title,
            sous_titre: section.subtitle,
            products: section.products
        }) }}

        {% if blocs[loop.index0] is defined %}{{ include(blocs[loop.index0]) }}{% endif %}
    {% endfor %}
    {% for bloc in blocs|slice(sections|length) %}{{ include(bloc) }}{% endfor %}

    {{ include('front/_showroom.html.twig') }}

    {{ include('front/_faq.html.twig') }}

    {{ include('front/_cta_whatsapp.html.twig') }}

{% endblock %}