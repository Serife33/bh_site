
{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <h1>{{ product.name }}</h1>

    <table>
        <tr><th>Slug</th><td>{{ product.slug }}</td></tr>
        <tr><th>Description</th><td>{{ product.description|nl2br }}</td></tr>
        <tr><th>Dimensions</th><td>{{ product.dimension|nl2br }}</td></tr>
        <tr><th>Prix initial</th><td>{{ product.initialPrice }} €</td></tr>
        <tr><th>Prix actuel</th><td>{{ product.actualPrice }} €</td></tr>
        <tr><th>Stock</th><td>{{ product.stock }}</td></tr>
        <tr><th>Sur mesure</th><td>{{ product.isCustomMade ? 'Oui' : 'Non' }}</td></tr>
        <tr><th>Modulable</th><td>{{ product.isModular.value }}</td></tr>
        <tr><th>Côté</th><td>{{ product.sideLr.value }}</td></tr>
        <tr><th>Délai</th><td>{{ product.leadMinWeeks }} à {{ product.leadMaxWeeks }} semaines</td></tr>
        <tr><th>Catégorie</th><td>{{ product.category.name }}</td></tr>
        <tr><th>Famille</th><td>{{ product.family ? product.family.name : '—' }}</td></tr>
        <tr><th>Tissus</th><td>{% for f in product.fabrics %}{{ f.name }} {% else %}—{% endfor %}</td></tr>
        <tr><th>Couleurs</th><td>{% for c in product.colors %}{{ c.name }} {% else %}—{% endfor %}</td></tr>
        <tr><th>Visible</th><td>{{ product.isActive ? 'Oui' : 'Non' }}</td></tr>
    </table>


    <h2>Photos</h2>

    <p class="photos-actions">
        <a href="{{ path('app_media_new', {id: product.id}) }}">+ Ajouter une photo</a>
        <span id="ordre-message" class="ordre-message" role="status" aria-live="polite"></span>
    </p>

    {% if product.media|length %}
        <p class="photos-aide">Tire une vignette par sa poignée ⠿ pour changer l'ordre sur le site. L'enregistrement est immédiat.</p>

        <ul id="grille-photos"
            class="grille-photos"
            data-url="{{ path('app_media_order_save') }}"
            data-token="{{ csrf_token('ordre-photos') }}">
            {% for media in product.media %}
                <li class="photo-carte" data-id="{{ media.id }}">
                    <span class="ordre-poignee" aria-hidden="true">⠿</span>
                    <span class="ordre-rang">{{ loop.index }}</span>

                    <img src="{{ vich_uploader_asset(media, 'imageFile') | imagine_filter('vignette') }}" alt="{{ media.alt }}">

                    <div class="photo-infos">
                        {% if loop.first %}<span class="photo-etiquette photo-principale">Vignette catalogue</span>{% endif %}
                        {% if loop.index == 2 %}<span class="photo-etiquette photo-survol">Au survol</span>{% endif %}
                        {% if media.alt is empty %}<span class="photo-etiquette photo-alerte">Alt manquant</span>{% endif %}
                        <span class="photo-alt">{{ media.alt }}</span>
                    </div>

                    <div class="photo-boutons">
                        <a href="{{ path('app_media_edit', {id: media.id}) }}">Modifier</a>
                        {{ include('media/_delete_form.html.twig', {media: media}) }}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune photo pour ce produit.</p>
    {% endif %}

    <a href="{{ path('app_product_index') }}">← Retour</a>
    <a href="{{ path('app_product_edit', {id: product.id}) }}">Modifier</a>
    <a href="{{ path('app_product_duplicate', {id: product.id}) }}">Dupliquer</a>



    {{ include('product/_delete_form.html.twig') }}
{% endblock %}