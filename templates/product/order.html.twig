{% extends 'base.html.twig' %}

{% block title %}Ordre d'affichage{% endblock %}

{% block body %}
    <h1>Ordre d'affichage</h1>
    <p>Faites glisser les produits par leur poignée pour changer leur ordre sur le site.
       L'enregistrement est automatique.</p>

    {# Choix de la catégorie : simple formulaire en GET, il recharge la page #}
    <form method="get" action="{{ path('app_product_order') }}" class="ordre-choix">
        <label for="choix-categorie">Catégorie</label>
        <select id="choix-categorie" name="categorie">
            {% for c in categories %}
                <option value="{{ c.id }}" {% if category and c.id == category.id %}selected{% endif %}>{{ c.name }}</option>
            {% endfor %}
        </select>
        <button type="submit">Afficher</button>
    </form>

    {% if products|length %}
        {{ include('admin/_order_list.html.twig', {
            url: path('app_product_order_save'),
            lignes: products|map(p => {
                id: p.id, nom: p.name, masque: not p.isActive,
                etiquette: p.isModular.value == 'module' ? 'module',
                liens: {Modifier: path('app_product_edit', {id: p.id})},
            }),
        }) }}
    {% else %}
        <p>Aucun produit dans cette catégorie.</p>
    {% endif %}
{% endblock %}