{# Une information de la société (paramètre company de config/services.yaml) : encadrée en pointillés tant qu'elle reste à compléter #}
{% macro info(valeur) %}{% if valeur starts with '[' %}<span class="ac">{{ valeur }}</span>{% else %}{{ valeur }}{% endif %}{% endmacro %}

{# Une remise en pourcentage telle qu'elle a été saisie : « 10 », « 12,5 » #}
{% macro taux(valeur) %}{{ valeur|replace({'.00': '', '.': ','}) }}&nbsp;%{% endmacro %}
